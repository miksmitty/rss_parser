# Server
PORT=3000

# SabNZB (optional). When set, "Send to SabNZB" is shown and used for downloads.
# Base URL of your SabNZB web interface (no trailing slash), e.g. http://localhost:8080
SABNZB_BASE_URL=http://127.0.0.1:8090
# API key from SabNZB: Config → General → API Key
SABNZB_API_KEY=
# Default category for added NZBs (must exist in SabNZB). Leave empty to use SabNZB default.
SABNZB_DEFAULT_CATEGORY=xxx

# Performer search (optional). NZBGeek/Newznab-compatible API.
# API base URL (no trailing slash). Default: https://api.nzbgeek.info/api
NZBGEEK_API_URL=https://api.nzbgeek.info/api
# API key from your indexer (required for performer search)
NZBGEEK_API_KEY=
# Search category (e.g. 6000). Leave empty or set to 6000 for adult.
NZBGEEK_SEARCH_CAT=6000
# Max results per search (default 200)
NZBGEEK_SEARCH_LIMIT=200
